#!/usr/bin/env bash
# autoclaude — manage the claude-keepalive systemd service
# Usage: ./autoclaude [command]

SERVICE="claude-keepalive"
LOG_FILE="$HOME/.claude_keepalive.log"

# colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# helpers
is_active() { systemctl is-active --quiet "$SERVICE"; }
is_enabled() { systemctl is-enabled --quiet "$SERVICE"; }

status_line() {
  if is_active; then
    echo -e "  status   ${GREEN}● running${RESET}"
  else
    echo -e "  status   ${RED}○ stopped${RESET}"
  fi

  if is_enabled; then
    echo -e "  boot     ${GREEN}enabled${RESET} (starts on reboot)"
  else
    echo -e "  boot     ${DIM}disabled${RESET}"
  fi

  if [[ -f "$LOG_FILE" ]]; then
    local last
    last=$(grep -E "✓|✗" "$LOG_FILE" | tail -1)
    if [[ -n "$last" ]]; then
      if echo "$last" | grep -q "✓"; then
        echo -e "  last ping ${GREEN}${last}${RESET}"
      else
        echo -e "  last ping ${RED}${last}${RESET}"
      fi
    fi

    local next
    next=$(grep "Next ping" "$LOG_FILE" | tail -1)
    [[ -n "$next" ]] && echo -e "  ${DIM}${next}${RESET}"
  fi
}

header() {
  echo -e "\n${BOLD}${CYAN}AutoClaude${RESET} — keepalive manager\n"
}

# commands
cmd_status() {
  header
  status_line
  echo
}

cmd_start() {
  header
  if is_active; then
    echo -e "${YELLOW}Already running.${RESET}"
  else
    systemctl start "$SERVICE" && echo -e "${GREEN}Started.${RESET}" || echo -e "${RED}Failed to start.${RESET}"
  fi
  echo
  status_line
  echo
}

cmd_stop() {
  header
  if ! is_active; then
    echo -e "${YELLOW}Already stopped.${RESET}"
  else
    systemctl stop "$SERVICE" && echo -e "${GREEN}Stopped.${RESET}" || echo -e "${RED}Failed to stop.${RESET}"
  fi
  echo
  status_line
  echo
}

cmd_restart() {
  header
  systemctl restart "$SERVICE" && echo -e "${GREEN}Restarted.${RESET}" || echo -e "${RED}Failed to restart.${RESET}"
  echo
  status_line
  echo
}

cmd_enable() {
  header
  systemctl enable "$SERVICE" 2>/dev/null && echo -e "${GREEN}Enabled — will start on reboot.${RESET}"
  echo
}

cmd_disable() {
  header
  systemctl disable "$SERVICE" 2>/dev/null && echo -e "${YELLOW}Disabled — will not start on reboot.${RESET}"
  echo
}

cmd_logs() {
  local lines="${1:-50}"
  header
  echo -e "${DIM}Showing last $lines lines — Ctrl+C to exit${RESET}\n"
  journalctl -u "$SERVICE" -n "$lines" --no-pager
}

cmd_follow() {
  header
  echo -e "${DIM}Live logs — Ctrl+C to exit${RESET}\n"
  journalctl -u "$SERVICE" -f
}

cmd_ping() {
  header
  echo -e "Sending a manual ping now...\n"
  if claude -p "." --no-auto-continue 2>/dev/null; then
    echo -e "\n${GREEN}✓ Ping succeeded.${RESET}"
  else
    echo -e "\n${RED}✗ Ping failed — is Claude Code installed and authenticated?${RESET}"
  fi
  echo
}

cmd_help() {
  header
  echo -e "${BOLD}Usage:${RESET} autoclaude [command]\n"
  echo -e "  ${CYAN}status${RESET}       Show current service status"
  echo -e "  ${CYAN}start${RESET}        Start the keepalive service"
  echo -e "  ${CYAN}stop${RESET}         Stop the keepalive service"
  echo -e "  ${CYAN}restart${RESET}      Restart the keepalive service"
  echo -e "  ${CYAN}enable${RESET}       Enable auto-start on reboot"
  echo -e "  ${CYAN}disable${RESET}      Disable auto-start on reboot"
  echo -e "  ${CYAN}logs [N]${RESET}     Show last N log lines (default: 50)"
  echo -e "  ${CYAN}follow${RESET}       Live log stream"
  echo -e "  ${CYAN}ping${RESET}         Send a manual ping right now"
  echo -e "  ${CYAN}help${RESET}         Show this message"
  echo
}

# router
case "${1:-status}" in
  status)           cmd_status ;;
  start)            cmd_start ;;
  stop)             cmd_stop ;;
  restart)          cmd_restart ;;
  enable)           cmd_enable ;;
  disable)          cmd_disable ;;
  logs)             cmd_logs "${2:-50}" ;;
  follow)           cmd_follow ;;
  ping)             cmd_ping ;;
  help|--help|-h)   cmd_help ;;
  *)
    echo -e "${RED}Unknown command: $1${RESET}"
    cmd_help
    exit 1
    ;;
esac